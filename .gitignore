codes/figures/outputs/

# ----------------------------------------------------------------------
# Large resting-state intermediate outputs
#
# These are generated by the analysis pipeline but are intentionally not
# distributed because of their storage requirements.
# ----------------------------------------------------------------------

# Full trained-model collection.
# Keep only the example model required by Figure 2.
codes/HCP/results/ANN_model/*
!codes/HCP/results/ANN_model/README.txt
!codes/HCP/results/ANN_model/id_108222_MLP.pt

# Full processed participant arrays.
# Keep only the example resting-state signal required by example/null figures.y

codes/HCP/results/processed/*
!codes/HCP/results/processed/README.txt
!codes/HCP/results/processed/id_100206_signals.npy
!codes/HCP/results/processed/id_100206_inputs.npy
!codes/HCP/results/processed/id_100206_targets.npy
# Full time-resolved EC/BEC tensors.
# Compact figure caches are stored separately and are not ignored.
codes/HCP/results/ECts/*
codes/HCP/results/BECts/*

# Multi-GB Step-4 state-dependence dataframes.
# These can be regenerated from the full EC/BEC tensors.
codes/HCP/results/dataframes/HCP_4_df_background_dependence_ECts.csv
codes/HCP/results/dataframes/HCP_4_df_background_dependence_BECts.csv

# BEC Step-6 dataframe is not required for manuscript figure reproduction.
codes/HCP/results/dataframes/HCP_5_df_spatial_network_receptors_BECts_cortical400.csv
codes/HCP/results/dataframes/HCP_5_df_spatial_network_receptors_BECts_cortical400.pkl

# Pearson diagnostic cache.
# The manuscript figure uses the separately stored Spearman cache.
codes/HCP/results/Figure4_PanelB_node_corr_HCP.csv

